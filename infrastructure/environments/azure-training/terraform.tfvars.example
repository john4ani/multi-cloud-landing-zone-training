deploy_workload      = false
owner                = "your-name"
cost_centre          = "training"
expires_at           = "2026-08-31"
budget_start_date    = "2026-07-01T00:00:00Z"
alert_contact_emails = ["you@example.com"]

# Build and publish the API first, then replace this with its immutable digest.
api_container_image = "ghcr.io/your-github-account/cloud-training-api@sha256:replace-with-64-hex-characters"

# Keep authentication disabled until the Entra application objects are configured.
authentication_enabled = false
entra_authority        = "https://login.microsoftonline.com/<tenant-id>/v2.0"
entra_audience         = "cloud-training-api"

# Never put sql_admin_password in this file. Supply it only through:
# $env:TF_VAR_sql_admin_password = '<strong-bootstrap-password>'
