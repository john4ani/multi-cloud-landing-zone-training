FROM mcr.microsoft.com/dotnet/sdk:10.0.201 AS build
WORKDIR /source
COPY . .
RUN dotnet publish src/CloudArchitectureTraining.Api/CloudArchitectureTraining.Api.csproj \
    --configuration Release --output /app --no-self-contained

FROM mcr.microsoft.com/dotnet/aspnet:10.0.5
WORKDIR /app
COPY --from=build /app .
USER $APP_UID
EXPOSE 8080
ENTRYPOINT ["dotnet", "CloudArchitectureTraining.Api.dll"]
